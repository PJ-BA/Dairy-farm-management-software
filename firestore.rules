rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 5 && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // --- ENTITY VALIDATORS ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.farmName is string && data.farmName.size() >= 1 && data.farmName.size() <= 100 &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 6 &&
             data.defaultMilkPrice is number && data.defaultMilkPrice >= 0 && data.defaultMilkPrice <= 10000 &&
             data.feedingRemindersEnabled is bool &&
             data.lowStockAlertsEnabled is bool &&
             data.productionDropAlertsEnabled is bool;
    }

    function isValidCattle(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.tagNumber is string && data.tagNumber.size() >= 1 && data.tagNumber.size() <= 40 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.species in ['Cow', 'Buffalo'] &&
             data.breed is string && data.breed.size() >= 1 && data.breed.size() <= 60 &&
             isValidDateStr(data.registrationDate) &&
             data.isActive is bool &&
             data.notes is string && data.notes.size() <= 500;
    }

    function isValidMilkRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.cattleId is string && isValidId(data.cattleId) &&
             data.cattleTag is string && data.cattleTag.size() >= 1 && data.cattleTag.size() <= 40 &&
             data.cattleName is string && data.cattleName.size() >= 1 && data.cattleName.size() <= 80 &&
             isValidDateStr(data.date) &&
             data.morningLitres is number && data.morningLitres >= 0 && data.morningLitres <= 500 &&
             data.eveningLitres is number && data.eveningLitres >= 0 && data.eveningLitres <= 500 &&
             data.totalLitres is number && data.totalLitres >= 0 && data.totalLitres <= 1000 &&
             data.notes is string && data.notes.size() <= 500;
    }

    function isValidFeedItem(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.category in ['Green Fodder', 'Dry Fodder', 'Concentrate', 'Silage', 'Mineral Mix', 'Supplements'] &&
             data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000 &&
             data.unit in ['kg', 'grams', 'bales', 'litres'] &&
             data.costPerUnit is number && data.costPerUnit >= 0 && data.costPerUnit <= 1000000 &&
             data.minStockLevel is number && data.minStockLevel >= 0 && data.minStockLevel <= 1000000;
    }

    function isValidFeedingSchedule(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.targetGroup is string && data.targetGroup.size() >= 1 && data.targetGroup.size() <= 80 &&
             data.feedId is string && isValidId(data.feedId) &&
             data.feedName is string && data.feedName.size() >= 1 && data.feedName.size() <= 80 &&
             data.quantity is number && data.quantity > 0 && data.quantity <= 100000 &&
             data.unit in ['kg', 'grams', 'bales', 'litres'] &&
             isValidTimeStr(data.feedingTime) &&
             data.isActive is bool &&
             (data.lastCompletedDate == '' || isValidDateStr(data.lastCompletedDate));
    }

    function isValidFeedingRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.scheduleId is string && (data.scheduleId == '' || isValidId(data.scheduleId)) &&
             data.scheduleTitle is string && data.scheduleTitle.size() >= 1 && data.scheduleTitle.size() <= 100 &&
             data.feedId is string && isValidId(data.feedId) &&
             data.feedName is string && data.feedName.size() >= 1 && data.feedName.size() <= 80 &&
             data.quantityConsumed is number && data.quantityConsumed > 0 && data.quantityConsumed <= 100000 &&
             data.unit in ['kg', 'grams', 'bales', 'litres'] &&
             isValidDateStr(data.date) &&
             isValidTimeStr(data.time) &&
             data.status in ['Completed', 'Missed'] &&
             data.notes is string && data.notes.size() <= 500;
    }

    function isValidTransaction(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidDateStr(data.date) &&
             data.type in ['Income', 'Expense'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.description is string && data.description.size() <= 300 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             data.quantityLitres is number && data.quantityLitres >= 0 && data.quantityLitres <= 1000000 &&
             data.pricePerLitre is number && data.pricePerLitre >= 0 && data.pricePerLitre <= 100000 &&
             data.paymentMethod in ['Cash', 'UPI', 'Bank Transfer', 'Card'];
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'farmName', 'currencySymbol',
                         'defaultMilkPrice', 'feedingRemindersEnabled', 'lowStockAlertsEnabled',
                         'productionDropAlertsEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'farmName', 'currencySymbol',
                         'defaultMilkPrice', 'feedingRemindersEnabled', 'lowStockAlertsEnabled',
                         'productionDropAlertsEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'farmName', 'currencySymbol',
                         'defaultMilkPrice', 'feedingRemindersEnabled', 'lowStockAlertsEnabled',
                         'productionDropAlertsEnabled', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Cattle
      match /cattle/{cattleId} {
        allow get: if isOwner(userId) && isValidId(cattleId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(cattleId) &&
                         incoming().keys().hasAll([
                           'userId', 'tagNumber', 'name', 'species', 'breed',
                           'registrationDate', 'isActive', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'tagNumber', 'name', 'species', 'breed',
                           'registrationDate', 'isActive', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCattle(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidId(cattleId) &&
                         isValidCattle(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'tagNumber', 'name', 'species', 'breed',
                           'registrationDate', 'isActive', 'notes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(cattleId);
      }

      // Milk Production Records
      match /milkRecords/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(recordId) &&
                         incoming().keys().hasAll([
                           'userId', 'cattleId', 'cattleTag', 'cattleName', 'date',
                           'morningLitres', 'eveningLitres', 'totalLitres', 'notes',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'cattleId', 'cattleTag', 'cattleName', 'date',
                           'morningLitres', 'eveningLitres', 'totalLitres', 'notes',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidMilkRecord(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         exists(/databases/$(database)/documents/users/$(userId)/cattle/$(incoming().cattleId));

        allow update: if isOwner(userId) &&
                         isValidId(recordId) &&
                         isValidMilkRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cattleId', 'cattleTag', 'cattleName', 'date',
                           'morningLitres', 'eveningLitres', 'totalLitres', 'notes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      // Feed Inventory Items
      match /feedItems/{feedId} {
        allow get: if isOwner(userId) && isValidId(feedId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(feedId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'category', 'quantity', 'unit',
                           'costPerUnit', 'minStockLevel', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'category', 'quantity', 'unit',
                           'costPerUnit', 'minStockLevel', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFeedItem(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidId(feedId) &&
                         isValidFeedItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'category', 'quantity', 'unit',
                           'costPerUnit', 'minStockLevel', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(feedId);
      }

      // Feeding Schedules
      match /feedingSchedules/{scheduleId} {
        allow get: if isOwner(userId) && isValidId(scheduleId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(scheduleId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'targetGroup', 'feedId', 'feedName',
                           'quantity', 'unit', 'feedingTime', 'isActive',
                           'lastCompletedDate', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'targetGroup', 'feedId', 'feedName',
                           'quantity', 'unit', 'feedingTime', 'isActive',
                           'lastCompletedDate', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFeedingSchedule(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         exists(/databases/$(database)/documents/users/$(userId)/feedItems/$(incoming().feedId));

        allow update: if isOwner(userId) &&
                         isValidId(scheduleId) &&
                         isValidFeedingSchedule(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'targetGroup', 'feedId', 'feedName', 'quantity',
                           'unit', 'feedingTime', 'isActive', 'lastCompletedDate', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(scheduleId);
      }

      // Feeding Activity Records
      match /feedingRecords/{feedingRecordId} {
        allow get: if isOwner(userId) && isValidId(feedingRecordId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(feedingRecordId) &&
                         incoming().keys().hasAll([
                           'userId', 'scheduleId', 'scheduleTitle', 'feedId', 'feedName',
                           'quantityConsumed', 'unit', 'date', 'time', 'status',
                           'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'scheduleId', 'scheduleTitle', 'feedId', 'feedName',
                           'quantityConsumed', 'unit', 'date', 'time', 'status',
                           'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFeedingRecord(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         exists(/databases/$(database)/documents/users/$(userId)/feedItems/$(incoming().feedId));

        allow update: if isOwner(userId) &&
                         isValidId(feedingRecordId) &&
                         isValidFeedingRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'scheduleId', 'scheduleTitle', 'feedId', 'feedName',
                           'quantityConsumed', 'unit', 'date', 'time', 'status', 'notes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(feedingRecordId);
      }

      // Financial Transactions
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll([
                           'userId', 'date', 'type', 'category', 'description',
                           'amount', 'quantityLitres', 'pricePerLitre', 'paymentMethod',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'date', 'type', 'category', 'description',
                           'amount', 'quantityLitres', 'pricePerLitre', 'paymentMethod',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTransaction(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'date', 'type', 'category', 'description', 'amount',
                           'quantityLitres', 'pricePerLitre', 'paymentMethod', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
